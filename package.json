{
  "name": "tree",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A macOS desktop application for working with hierarchical text nodes and image attachments.",
  "main": "out/main/index.js",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "postinstall": "install-electron",
    "prepare": "git config core.hooksPath .githooks",
    "predev": "node scripts/rename-dev-app.mts",
    "dev": "electron-vite dev --config config/build/electron.vite.config.ts",
    "dev:web": "node scripts/web/server.mts",
    "build:web": "node scripts/web/build.mts",
    "preview:web": "node scripts/web/static-server.mts",
    "pretest:web:built": "npm run build:web",
    "test:web:built": "TREE_WEB_BUILT=1 playwright test -c config/testing/playwright.web.config.ts",
    "test:web:chromium": "node scripts/web/chromium.mts",
    "test:web": "playwright test -c config/testing/playwright.web.config.ts",
    "test:safari": "npm run build:web && node scripts/web/safari.mts",
    "test:smoke:electron": "playwright test -c config/testing/playwright.smoke.config.ts --project=electron",
    "test:smoke:chromium": "playwright test -c config/testing/playwright.smoke.config.ts --project=chromium",
    "test:smoke:safari": "node scripts/smoke-safari.mts",
    "test:smoke:linux": "node scripts/web/linux-smoke.mts",
    "prestart": "node scripts/rename-dev-app.mts",
    "start": "electron-vite preview --config config/build/electron.vite.config.ts",
    "build": "electron-vite build --config config/build/electron.vite.config.ts",
    "demo:video": "playwright install ffmpeg && npm run build && node scripts/record-demo.mts",
    "typecheck:node": "tsc --noEmit -p config/typescript/tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p config/typescript/tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p config/typescript/tsconfig.e2e.json",
    "typecheck:scripts": "tsc --noEmit -p config/typescript/tsconfig.scripts.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer && npm run typecheck:e2e && npm run typecheck:scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/check-format-changed.mts",
    "validation:snapshot": "node scripts/validation-snapshot.mts",
    "screenshots:readme": "npm run build && node scripts/readme-screenshots.mts",
    "retire:file": "node scripts/retire-file.mts",
    "retire:scratch": "node scripts/retire-scratch.mts",
    "fix:history": "node scripts/fix-history.mts",
    "check:docs": "node scripts/check-docs.mts",
    "check:requirements": "node scripts/check-requirement-coverage.mts",
    "check:e2e-modes": "node scripts/check-e2e-editing-modes.mts",
    "check:opencode": "node scripts/check-opencode-permissions.mts",
    "changelog": "node scripts/changelog.mts --write",
    "doctor": "node scripts/doctor.mts",
    "audit": "npm audit",
    "test": "vitest run -c config/testing/vitest.config.ts",
    "test:watch": "vitest -c config/testing/vitest.config.ts",
    "test:coverage": "vitest run -c config/testing/vitest.config.ts --coverage",
    "test:performance": "vitest run -c config/testing/vitest.performance.config.ts",
    "test:property:soak": "TREE_PROPERTY_RUNS=20 NODE_OPTIONS=--max-old-space-size=4096 vitest run -c config/testing/vitest.config.ts --testTimeout=600000 .property.test.ts",
    "test:mutation": "stryker run config/testing/stryker.config.mjs",
    "test:e2e": "npm run build && playwright test -c config/testing/playwright.config.ts",
    "test:e2e:diagnose": "node scripts/e2e-diagnose.mts",
    "test:e2e:memory": "npm run test:e2e -- --config=config/testing/playwright.memory.config.ts",
    "test:e2e:changed": "npm run build && playwright test -c config/testing/playwright.config.ts --only-changed=HEAD",
    "test:e2e:timing": "npm run build && PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/e2e-timing.json playwright test -c config/testing/playwright.config.ts --reporter=list,json && node scripts/e2e-timing.mts",
    "test:e2e:visible": "TREE_E2E_VISIBLE=1 npm run test:e2e --",
    "test:perf": "npm run build && npm run build:web && playwright test -c config/testing/perf.config.ts",
    "test:perf:safari": "npm run build:web && npm run build && node perf/comparisons/safari-electron.mts",
    "test:perf:profile": "AGENDA_CPU_PROFILE=1 npm run test:perf --",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm run check:requirements && npm run check:e2e-modes && npm run check:opencode && npm run test:coverage && npm run test:performance && npm run build",
    "check:full": "npm run check && playwright test -c config/testing/playwright.config.ts && playwright test -c config/testing/perf.config.ts --project=electron && npm run audit"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
