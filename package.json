{
  "name": "tree",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A macOS desktop application for working with hierarchical text nodes and image attachments.",
  "main": "out/main/index.js",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11.8.0 <12"
  },
  "scripts": {
    "postinstall": "install-electron",
    "prepare": "git config core.hooksPath .githooks",
    "predev": "node scripts/rename-dev-app.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/rename-dev-app.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "demo:video": "playwright install ffmpeg && npm run build && node scripts/record-demo.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer && npm run typecheck:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:changed": "node scripts/check-format-changed.mjs",
    "validation:snapshot": "node scripts/validation-snapshot.mjs",
    "screenshots:readme": "npm run build && node scripts/readme-screenshots.mjs",
    "retire:file": "node scripts/retire-file.mjs",
    "fix:history": "node scripts/fix-history.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:requirements": "node scripts/check-requirement-coverage.mjs",
    "check:e2e-modes": "node scripts/check-e2e-editing-modes.mjs",
    "check:opencode": "node scripts/check-opencode-permissions.mjs",
    "changelog": "node scripts/changelog.mjs --write",
    "doctor": "node scripts/doctor.mjs",
    "audit": "npm audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run -c vitest.performance.config.ts",
    "test:property:soak": "TREE_PROPERTY_RUNS=20 NODE_OPTIONS=--max-old-space-size=4096 vitest run --testTimeout=600000 .property.test.ts",
    "test:mutation": "stryker run",
    "test:e2e": "npm run build && playwright test",
    "test:perf": "npm run build && playwright test -c perf.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:docs && npm run check:requirements && npm run check:e2e-modes && npm run check:opencode && npm run test:coverage && npm run test:performance && npm run build",
    "check:full": "npm run check && playwright test && playwright test -c perf.config.ts && npm run audit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
