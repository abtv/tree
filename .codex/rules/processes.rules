# Run this inspection by itself; filtering a pipeline requires separate allowances.
prefix_rule(
    pattern = ["ps", "-axo", "pid=,ppid=,command="],
    decision = "allow",
    match = ["ps -axo pid=,ppid=,command="],
    not_match = ["ps eww", "pkill Electron"],
)

prefix_rule(
    pattern = ["kill", "-INT"],
    decision = "allow",
    match = ["kill -INT 12345"],
    not_match = ["kill -KILL 12345", "killall Electron"],
)

prefix_rule(
    pattern = ["kill", "-TERM"],
    decision = "allow",
    match = ["kill -TERM 12345"],
    not_match = ["kill -9 12345", "pkill Electron"],
)
