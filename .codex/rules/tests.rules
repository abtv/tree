# Owner-approved standard validation commands from a trusted repository.
# These prefixes permit the named npm scripts and their ordinary test arguments
# outside the sandbox. Rules match argv, not cwd, and trust mutable repository
# scripts; this extends the existing named Electron workflow permission model.
# Restart Codex with the project's .codex layer trusted after changing rules,
# then verify an actual test launch without a prompt. Rule matching alone is
# configuration evidence, not proof of runtime access or task authorization.
prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Run the trusted repository's unit tests outside the sandbox without repeated approval",
    match = [
        "npm test",
        "npm test -- scripts/retire-scratch.test.mts",
    ],
    not_match = ["npm install", "npm exec node", "node arbitrary-script.mjs", "npm testing"],
)
prefix_rule(
    pattern = ["npm", "run", ["test", "test:coverage", "test:performance", "test:mutation", "check", "check:full"]],
    decision = "allow",
    justification = "Run the trusted repository's named validation workflows outside the sandbox without repeated approval",
    match = [
        "npm run test -- scripts/retire-scratch.test.mts",
        "npm run test:coverage",
        "npm run test:performance",
        "npm run test:mutation",
        "npm run test:mutation -- --mutate src/domain/emoji-completion.ts --concurrency 4",
        "npm run test:mutation -- --shard application --concurrency 4",
        "npm run test:mutation -- --shard domain",
        "npm run test:mutation -- --shard=renderer",
        "npm run check",
        "npm run check:full",
    ],
    not_match = ["npm run unknown", "npm install", "npm run check:full-extra", "npm run test:mutation-extra", "npm exec node"],
)

# Named Electron workflows accept spec paths and Playwright flags without shell env prefixes.
prefix_rule(
    pattern = ["npm", "run", ["test:e2e", "test:e2e:changed", "test:e2e:diagnose", "test:e2e:memory", "test:e2e:visible", "test:perf", "test:perf:safari", "test:perf:profile"]],
    decision = "allow",
    match = [
        "npm run test:e2e:changed -- --list",
        "npm run test:e2e:memory",
        "npm run test:e2e:memory -- --workers=1",
        "npm run test:e2e:diagnose -- --shared-reset=reload --json-output=.scratch/diagnostics/report.json e2e/navigation.spec.ts --workers=6 --repeat-each=5 --reporter=dot,json",
        "npm run test:e2e:visible -- e2e/drag-and-drop-hierarchy.spec.ts --workers=1 --update-snapshots",
        "npm run test:perf:profile -- perf/agenda-scale.spec.ts --grep deep-100000-dense",
        "npm run test:perf:safari",
    ],
    not_match = ["npm run unknown", "npm install", "npm run test:e2e:visible-extra", "npm run test:e2e:diagnose-extra", "npm run test:e2e:memory-extra", "npm run test:perf:safari-extra"],
)

# Named desktop launch and synthetic media workflows require host GUI access.
prefix_rule(
    pattern = ["npm", "run", ["dev", "start", "demo:video", "screenshots:readme"]],
    decision = "allow",
    justification = "Run trusted desktop development and isolated synthetic media workflows without repeated approval",
    match = ["npm run dev", "npm run start", "npm run demo:video", "npm run screenshots:readme"],
    not_match = ["npm run dev-extra", "npm run start-extra", "npm run demo:video-extra", "npm run screenshots:readme-extra", "npm run deploy", "npm install"],
)

# Owner-approved isolated Chrome verification of the generated static package.
# Like the other npm rules, this trusts the repository script and matches argv,
# not the current directory. Review script changes before using this allowance.
prefix_rule(
    pattern = ["npm", "run", "test:web:built"],
    decision = "allow",
    justification = "Build the static Tree package and verify it in isolated Chrome outside the sandbox",
    match = ["npm run test:web:built"],
    not_match = ["npm run test:web", "npm run test:web:built-extra", "npm run dev:web", "npm install", "node arbitrary-script.mjs"],
)

# Owner-approved browser checks and local-only development/preview servers.
# These allowances trust the named repository scripts outside the sandbox;
# they do not permit arbitrary npm scripts, publishing, or dependency changes.
prefix_rule(
    pattern = ["npm", "run", ["test:web", "test:safari", "test:smoke:electron", "test:smoke:chromium", "test:smoke:safari", "dev:web", "preview:web"]],
    decision = "allow",
    justification = "Run trusted browser checks and local Tree servers without repeated approval",
    match = [
        "npm run test:web",
        "npm run test:web -- quit",
        "npm run test:web -- storage",
        "npm run test:safari",
        "npm run test:safari -- --help",
        "npm run dev:web",
        "npm run preview:web",
    ],
    not_match = ["npm run test:web:built", "npm run test:web-extra", "npm run test:safari-extra", "npm run dev:web-extra", "npm run preview:web-extra", "npm run deploy", "npm install", "npm exec node", "node arbitrary-script.mjs"],
)
