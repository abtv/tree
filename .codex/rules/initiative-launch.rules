# Only the reviewed, fixed-operation launcher. The wrapper rejects extra args.
# Project trust is required; changes to the launcher require security review.
prefix_rule(
    pattern = ["node", "/Users/andrew/work/tree/scripts/initiative-launch.mjs", ["develop-aw3", "review-aw3", "verify-aw3"]],
    decision = "allow",
    justification = "Launch one sandboxed AW-3 run with fixed repository, role and bounds",
    match = [
        "node /Users/andrew/work/tree/scripts/initiative-launch.mjs develop-aw3",
        "node /Users/andrew/work/tree/scripts/initiative-launch.mjs review-aw3",
        "node /Users/andrew/work/tree/scripts/initiative-launch.mjs verify-aw3",
    ],
    not_match = [
        "codex exec --sandbox workspace-write arbitrary-prompt",
        "node /Users/andrew/work/tree/scripts/initiative-launch.mjs arbitrary-prompt",
        "node /Users/andrew/work/tree/scripts/initiative-launch.mjs --dangerously-bypass-approvals-and-sandbox",
        "node /another/repository/scripts/initiative-launch.mjs develop-aw3",
    ],
)
