{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "develop",
  "model": "deepseek/deepseek-flash",
  "subagent_depth": 1,
  "provider": {
    "deepseek": {
      "whitelist": ["deepseek-flash"],
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  },
  "agent": {
    "develop": {
      "description": "Owns an approved task from planning through implementation, independent review, verification, documentation, and commit",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/agents/develop.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "sudo*": "deny",
          "doas*": "deny",
          "su": "deny",
          "su *": "deny",
          "sh": "deny",
          "sh *": "deny",
          "bash": "deny",
          "bash *": "deny",
          "zsh": "deny",
          "zsh *": "deny",
          "fish": "deny",
          "fish *": "deny",
          "node": "deny",
          "node *": "deny",
          "python*": "deny",
          "ruby*": "deny",
          "perl*": "deny",
          "osascript*": "deny",
          "rm *": "deny",
          "rm WORKING_PLAN.md": "allow",
          "rm -f WORKING_PLAN.md": "allow",
          "rmdir *": "deny",
          "chmod *": "deny",
          "chown *": "deny",
          "killall *": "deny",
          "kill *": "deny",
          "pkill *": "deny",
          "git *": "deny",
          "npm install*": "deny",
          "npm i": "deny",
          "npm i *": "deny",
          "npm ci*": "deny",
          "npm add*": "deny",
          "npm remove*": "deny",
          "npm rm*": "deny",
          "npm uninstall*": "deny",
          "npm update*": "deny",
          "npm exec*": "deny",
          "npm dlx*": "deny",
          "pnpm *": "deny",
          "yarn *": "deny",
          "bun *": "deny",
          "corepack *": "deny",
          "npx *": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git add *": "allow",
          "git commit": "allow",
          "git commit *": "allow",
          "git commit *--amend*": "deny",
          "git commit *--no-verify*": "deny",
          "git commit -n": "deny",
          "git commit -n *": "deny",
          "git commit * -n": "deny",
          "git commit * -n *": "deny",
          "npx vitest": "allow",
          "npx vitest *": "allow",
          "npx playwright test": "allow",
          "npx playwright test *": "allow",
          "npm test": "allow",
          "npm test *": "allow",
          "npm audit": "allow",
          "npm audit *": "allow",
          "npm audit fix*": "deny",
          "npm audit *fix*": "deny",
          "npm run dev": "allow",
          "npm run dev *": "allow",
          "npm run start": "allow",
          "npm run start *": "allow",
          "npm run build": "allow",
          "npm run build *": "allow",
          "npm run typecheck": "allow",
          "npm run typecheck *": "allow",
          "npm run typecheck:*": "allow",
          "npm run lint": "allow",
          "npm run lint *": "allow",
          "npm run format": "allow",
          "npm run format *": "allow",
          "npm run format:check": "allow",
          "npm run format:check *": "allow",
          "npm run format:check:changed": "allow",
          "npm run format:check:changed *": "allow",
          "npm run check:docs": "allow",
          "npm run check:docs *": "allow",
          "npm run check:requirements": "allow",
          "npm run check:requirements *": "allow",
          "npm run check:e2e-modes": "allow",
          "npm run check:e2e-modes *": "allow",
          "npm run check:opencode": "allow",
          "npm run check:opencode *": "allow",
          "npm run validation:snapshot": "allow",
          "npm run validation:snapshot *": "allow",
          "npm run screenshots:status": "allow",
          "npm run screenshots:readme": "allow",
          "npm run retire:file": "allow",
          "npm run retire:file *": "allow",
          "npm run fix:history": "allow",
          "npm run fix:history *": "allow",
          "npm run changelog": "allow",
          "npm run changelog *": "allow",
          "npm run doctor": "allow",
          "npm run doctor *": "allow",
          "npm run audit": "allow",
          "npm run audit *": "allow",
          "npm run audit *fix*": "deny",
          "npm run test": "allow",
          "npm run test *": "allow",
          "npm run test:watch": "allow",
          "npm run test:watch *": "allow",
          "npm run test:coverage": "allow",
          "npm run test:coverage *": "allow",
          "npm run test:property:soak": "allow",
          "npm run test:property:soak *": "allow",
          "npm run test:mutation": "allow",
          "npm run test:mutation *": "allow",
          "npm run test:e2e": "allow",
          "npm run test:e2e *": "allow",
          "npm run test:perf": "allow",
          "npm run test:perf *": "allow",
          "npm run check": "allow",
          "npm run check *": "allow",
          "npm run check *fix*": "deny",
          "npm run check:full": "allow",
          "npm run check:full *": "allow",
          "pkill -f tree-e2e-*": "allow",
          "pkill -f tree-perf-*": "allow",
          "ps *": "allow",
          "pgrep *": "allow",
          "pgrep -fl tree-e2e-*": "allow",
          "pgrep -fl tree-perf-*": "allow",
          "cat*": "allow",
          "head *": "allow",
          "tail *": "allow",
          "ls*": "allow",
          "wc *": "allow",
          "diff *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "du *": "allow",
          "mktemp*": "allow",
          "pwd": "allow",
          "echo *": "allow",
          "true": "allow",
          "true *": "allow",
          "find *": "allow",
          "find *-delete*": "deny",
          "find *-exec*": "deny",
          "find *-execdir*": "deny",
          "find *-fprint*": "deny",
          "rg *": "allow",
          "rg *--pre*": "deny",
          "sed *": "allow",
          "sed *-i*": "deny",
          "awk": "allow",
          "awk *": "allow",
          "awk *system(*": "deny",
          "awk *system (*": "deny",
          "awk -f*": "deny",
          "awk * -f*": "deny",
          "awk --file*": "deny",
          "awk * --file*": "deny",
          "sort": "allow",
          "sort *": "allow",
          "xargs wc *": "allow",
          "cut *": "allow",
          "fold": "allow",
          "fold *": "allow",
          "tr *": "allow",
          "uniq": "allow",
          "uniq *": "allow",
          "basename *": "allow",
          "dirname *": "allow",
          "realpath *": "allow",
          "which *": "allow",
          "unzip -l test-results/*/trace.zip": "allow",
          "unzip -q -o test-results/*/trace.zip -d test-results/trace-unpacked": "allow",
          "grep *": "allow",
          "xxd *": "allow",
          "shasum *": "allow",
          "cksum *": "allow",
          "md5 *": "allow",
          "tmutil listlocalsnapshots *": "allow",
          "mkdir *": "allow",
          "npx tsc *": "allow",
          "git grep *": "allow",
          "git grep *--open*": "deny",
          "git grep *-O*": "deny",
          "git ls-files *": "allow",
          "git rev-parse *": "allow",
          "git blame *": "allow",
          "git branch": "allow",
          "git branch -a": "allow",
          "git branch -v": "allow",
          "git branch -vv": "allow",
          "git branch --list": "allow",
          "git branch --show-current": "allow",
          "git stash list": "allow",
          "git stash list *": "allow",
          "cp test-results/* test-results/*": "allow",
          "cp -R test-results/* test-results/*": "allow",
          "mv e2e/_* test-results/*": "allow",
          "mv perf/_* test-results/*": "allow",
          "mv test-results/* test-results/*": "allow",
          "TREE_E2E_VISIBLE=1 npm run test:e2e": "allow",
          "TREE_E2E_VISIBLE=1 npm run test:e2e *": "allow",
          "TREE_E2E_VISIBLE=1 npx playwright test": "allow",
          "TREE_E2E_VISIBLE=1 npx playwright test *": "allow",
          "TREE_PERSISTENCE_DEBUG=1 npm run dev": "allow",
          "TREE_PERSISTENCE_DEBUG=1 npm run dev *": "allow",
          "PERF_RESULTS=\"test-results/*\" npm run test:perf": "allow",
          "PERF_RESULTS=\"test-results/*\" npm run test:perf *": "allow",
          "PERF_BASELINE=\"*\" npm run test:perf": "allow",
          "PERF_BASELINE=\"*\" npm run test:perf *": "allow",
          "PERF_REGRESSION_TOLERANCE=\"*\" npm run test:perf": "allow",
          "PERF_REGRESSION_TOLERANCE=\"*\" npm run test:perf *": "allow"
        },
        "task": {
          "*": "deny",
          "planner": "allow",
          "product-researcher": "allow",
          "reviewer": "allow",
          "product-verifier": "allow"
        },
        "external_directory": "deny",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "planner": {
      "description": "Inspects the repository in a fresh context and proposes a focused implementation plan",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "max",
      "prompt": "{file:./.opencode/agents/planner.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "product-researcher": {
      "description": "Investigates a bounded product hypothesis and proposes evidence and experiments without making product decisions",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/agents/product-researcher.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "description": "Independently reviews an implementation and reports only meaningful findings",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "product-verifier": {
      "description": "Checks the changed behavior as a careful user and reports meaningful product issues",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "reasoningEffort": "high",
      "prompt": "{file:./.opencode/agents/product-verifier.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "npm test": "allow",
          "npm run test:e2e": "allow",
          "npm run test:perf": "allow",
          "npm run build": "allow",
          "TREE_E2E_VISIBLE=1 npm run test:e2e": "allow"
        },
        "task": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
