{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run format:check*)",
      "Bash(npm run check:docs*)",
      "Bash(npm run check:opencode*)",
      "Bash(npm run test*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run test:e2e*)",
      "Bash(npm run test:perf*)",
      "Bash(TREE_E2E_VISIBLE=1 npm run test:e2e*)"
    ],
    "deny": [
      "Bash(python*)",
      "Bash(node)",
      "Bash(node *)",
      "Bash(perl*)",
      "Bash(ruby*)",
      "Bash(osascript*)",
      "Bash(sh)",
      "Bash(sh *)",
      "Bash(bash)",
      "Bash(bash *)",
      "Bash(zsh)",
      "Bash(zsh *)",
      "Bash(fish)",
      "Bash(fish *)",
      "Bash(sed -i*)",
      "Bash(sed *-i*)"
    ]
  }
}
